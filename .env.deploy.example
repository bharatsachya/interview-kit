# ─────────────────────────────────────────────────────────────────────────────
# Deployment secrets for `./scripts/deploy-api.sh`. Copy to `.env.deploy`, which is gitignored.
#
# This file is only for the Azure deploy. Local development reads `.env` — see `.env.example`.
# ─────────────────────────────────────────────────────────────────────────────

# Azure. AZ_ACR must be globally unique and lowercase alphanumeric; the rest have defaults.
AZ_ACR=prepkit
AZ_RESOURCE_GROUP=prep-kit
AZ_LOCATION=westeurope
AZ_ENV=prep-kit-env
AZ_APP=prep-kit-api

# ── Required in production ───────────────────────────────────────────────────
# The API refuses to start without the last two. An in-memory store that silently loses every
# kit on a restart, or a dev authenticator that trusts whatever the caller claims to be, are
# both fine locally and neither is a thing to discover in production.

GEMINI_API_KEY=

# Optional, and the one thing that makes a public demo link survive the day. Gemini's free tier
# is a daily cap of roughly twenty requests per model, and one kit costs six to eight calls.
# With more than one key set the deploy script sends LLM_PROVIDER empty, and the API uses them
# as a single chain — gemini → zai → openrouter — so a run that hits the wall mid-kit continues.
# ZAI_API_KEY=            # https://z.ai/manage-apikey/apikey-list  (GLM_API_KEY also works)
# OPENROUTER_API_KEY=     # https://openrouter.ai/keys — free, no card

# MongoDB Atlas free tier (M0). Network access must allow 0.0.0.0/0: Container Apps replicas do
# not have a stable outbound address unless the environment is put on a VNet with a NAT gateway,
# which the free tier of neither product justifies.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/prep-kit?retryWrites=true&w=majority

# The `iss` claim on Clerk's session tokens, which the API verifies against Clerk's JWKS.
# Development instance:  https://<slug>.clerk.accounts.dev
# Production instance:   https://clerk.<your-domain>
# Find it under API Keys → Show JWT public key, or decode a session token and read `iss`.
CLERK_ISSUER=

# ── Optional ─────────────────────────────────────────────────────────────────

# Without it, `search_discussion` records itself as skipped and the brief says so. Never a
# failure. https://tavily.com
TAVILY_API_KEY=

# Belt and braces. The browser never calls this API directly — apps/web proxies to it
# server-side, and a server-to-server call sends no Origin header, so CORS never applies to the
# traffic that matters. Setting it anyway means a stray page cannot make a browser call it.
# Comma-separated. Set it to the Vercel deployment's origin.
CORS_ORIGINS=https://your-app.vercel.app
