# ─────────────────────────────────────────────────────────────────────────────
# AI Interview Prep Kit — environment
#
# The batch command needs nothing here to run:
#   npm ci && npm run evaluate -- --input fixtures/cases.json --output kits.json --fake-llm --fake-fetch
# runs the full pipeline with no key and no network. Set GEMINI_API_KEY to run
# it against a real model.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED for a real run. Free tier at https://aistudio.google.com/apikey
# Limits apply per project, not per key — rotating keys buys nothing.
GEMINI_API_KEY=

# Which model each tier maps to. Requirement extraction is worth 20 points and
# asks for `quality`; everything else takes `fast`.
#
# Floating aliases on purpose. Google retires numbered models for newly issued
# keys — gemini-2.5-flash returns 404 "no longer available to new users" on a
# key created today — so a pinned version is a time bomb in a repo someone else
# runs later. Pin these only if you need an exact version.
GEMINI_MODEL_QUALITY=gemini-flash-latest
GEMINI_MODEL_FAST=gemini-flash-lite-latest

# Rate limits the gateway holds itself to. Stay under the published free-tier
# numbers rather than level with them.
GEMINI_RPM=10
GEMINI_TPM=250000

# OPTIONAL. Without it the public-discussion step is recorded as skipped and the
# brief notes the gap — it never fails a run. https://tavily.com (1,000/month,
# no card). Serper is the documented alternative; swapping is a one-line change
# in scripts/composition.ts.
TAVILY_API_KEY=

# OPTIONAL. Off by default, and it must stay off in production.
#
# Appendix B's own example serves its cases from http://localhost:8099/acme/,
# while the security requirements say reject loopback and private addresses.
# Both are right for their environment, so this is a flag rather than a
# decision baked into the code. `npm run evaluate` turns it on for itself;
# nothing else does.
ALLOW_PRIVATE_HOSTS=false

# OPTIONAL. The app needs these; the batch command does not — it uses the
# in-memory store, so a grader never has to stand up a database.
MONGODB_URI=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
