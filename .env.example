# ─────────────────────────────────────────────────────────────────────────────
# AI Interview Prep Kit — environment
#
# The batch command needs nothing here to run:
#   npm ci && npm run evaluate -- --input fixtures/cases.json --output kits.json --fake-llm --fake-fetch
# runs the full pipeline with no key and no network. Set GEMINI_API_KEY to run
# it against a real model.
# ─────────────────────────────────────────────────────────────────────────────

# Which provider to use: gemini | zai | openrouter.
#
# Leave blank and every provider you have a key for is used, as one model list
# in that order: Gemini first (fastest, but a hard daily cap), Z.AI next
# (separately metered, nearly as fast), OpenRouter last (slow and durable).
# The gateway already walks a model list and moves on when one reports itself
# unavailable, and a spent daily cap reports itself exactly that way — so the
# fallback across providers is the chain that was already there.
#
# Name one to pin it, which is what a measurement wants. A comma list changes
# the order without changing the code: LLM_PROVIDER=zai,gemini
LLM_PROVIDER=

# ── OpenRouter ───────────────────────────────────────────────────────────────
# An alternative to Gemini, worth having because Gemini's free tier is a daily
# wall rather than a rate limit: once it is spent, waiting does nothing.
# OpenRouter's free models draw on a different bucket.
# Key: https://openrouter.ai/keys (free, no card).
OPENROUTER_API_KEY=

# Comma-separated, preferred first. The `:free` suffix selects the zero-cost
# variant. These rotate as providers come and go, which is why it is a list.
# Leave unset for the built-in defaults.
# OPENROUTER_MODELS=deepseek/deepseek-chat-v3-0324:free,meta-llama/llama-3.3-70b-instruct:free

# Optional, for OpenRouter's leaderboards. Affects nothing else.
OPENROUTER_APP_URL=

# ── Z.AI (GLM) ───────────────────────────────────────────────────────────────
# The middle of the chain. Not drawn from either free bucket, and measured
# against a real extraction prompt glm-5.3-flash answers in about four seconds
# — so it is what to reach for once Gemini's day is spent, rather than dropping
# straight to OpenRouter's twenty.
# Key: https://z.ai/manage-apikey/apikey-list
# GLM_API_KEY is the same thing under the name the key is issued with; either works.
ZAI_API_KEY=
# GLM_API_KEY=

# Comma-separated, preferred first. One list for both tiers. Leave unset for the
# built-in defaults (glm-5.3, glm-5.3-flash, glm-4.6). GET /api/paas/v4/models
# lists what a key can actually reach — check it before suspecting the pipeline.
# ZAI_MODELS=glm-5.3-flash,glm-5.3

# Only for the mainland endpoint, which speaks the same dialect on another host.
# ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── Gemini ───────────────────────────────────────────────────────────────────
# REQUIRED for a real run unless you use OpenRouter. Free tier at https://aistudio.google.com/apikey
# Limits apply per project, not per key — rotating keys buys nothing.
GEMINI_API_KEY=

# Which model each tier maps to. Requirement extraction is worth 20 points and
# asks for `quality`; everything else takes `fast`.
#
# Comma-separated: preferred model first, fallbacks after. The gateway moves to
# the next one only when a model is unavailable (503 or a retired 404), never
# when a request is malformed or the quota is gone.
#
# Both kinds of name are in the list on purpose. Google retires numbered models
# for newly issued keys (gemini-2.5-flash 404s with "no longer available to new
# users"), so a pinned-only list rots. But the floating alias also returned 503
# on three consecutive runs while other models answered instantly, so an alias
# alone is no safer. Leave this unset to use the defaults.
# GEMINI_MODEL_QUALITY=gemini-flash-latest,gemini-3.6-flash,gemini-3.5-flash
# GEMINI_MODEL_FAST=gemini-flash-lite-latest,gemini-3.5-flash-lite

# Rate limits the gateway holds itself to. Stay under the published free-tier
# numbers rather than level with them.
GEMINI_RPM=10
GEMINI_TPM=250000

# OPTIONAL. Without it the public-discussion step is recorded as skipped and the
# brief notes the gap — it never fails a run. https://tavily.com (1,000/month,
# no card). Serper is the documented alternative; swapping is a one-line change
# in scripts/composition.ts.
TAVILY_API_KEY=

# OPTIONAL. Off by default, and it must stay off in production.
#
# Appendix B's own example serves its cases from http://localhost:8099/acme/,
# while the security requirements say reject loopback and private addresses.
# Both are right for their environment, so this is a flag rather than a
# decision baked into the code. `npm run evaluate` turns it on for itself;
# nothing else does.
ALLOW_PRIVATE_HOSTS=false

# OPTIONAL locally, REQUIRED in production. The app needs these; the batch
# command does not — it uses the in-memory store, so a grader never has to stand
# up a database.
#
# `apps/api` refuses to start under NODE_ENV=production without MONGODB_URI and
# CLERK_ISSUER. An in-memory store that loses every kit on a restart, and a dev
# authenticator that believes whatever the caller claims to be, are both fine on
# a laptop and neither is a thing to discover in production.
MONGODB_URI=
MONGODB_DB=

# The `iss` claim the API verifies session tokens against, using Clerk's JWKS.
# Development: https://<slug>.clerk.accounts.dev — Production: https://clerk.<domain>
# The API verifies tokens itself rather than trusting apps/web to have done it.
CLERK_ISSUER=

# The web app's own Clerk keys. See apps/web/.env.example.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# OPTIONAL. Comma-separated origins allowed to call the API from a browser.
# Unset, any origin may — which is harmless while apps/web proxies to the API
# server-side, because a server-to-server call carries no Origin header at all.
CORS_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────────
# Deploying
#
# Azure secrets live in `.env.deploy` — see `.env.deploy.example` and
# `docs/DEPLOYING.md`. Nothing in this file is read by the deployed API; Container
# Apps injects its own environment.
# ─────────────────────────────────────────────────────────────────────────────

# The API's port. apps/web reaches it through API_ORIGIN in apps/web/.env.local,
# and the two must agree — when they do not, the UI reports "The API returned a
# response that was not JSON", because the proxy reached whatever else happens
# to be on that port and got HTML back.
PORT=8787

# NOTE on MONGODB_URI: if the password contains any of  : / ? # [ ] @  it must be
# percent-encoded (@ becomes %40). An unencoded @ makes the driver split the URI
# at the wrong place and try to resolve the fragment after it as the hostname.
