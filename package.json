{
  "name": "trao-interview-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI Interview Prep Kit — job description to a researched, editable interview prep kit",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:real": "node scripts/dev-all.mjs --real",
    "api": "tsx watch apps/api/src/main.ts",
    "api:fake": "FAKE_LLM=true FAKE_FETCH=true tsx apps/api/src/main.ts",
    "dev:kit": "tsx scripts/dev.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "smoke": "tsx scripts/smoke.ts",
    "trace": "tsx scripts/trace-view.ts",
    "eval:step": "tsx evals/run-step.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node scripts/typecheck.mjs",
    "build": "npm run typecheck",
    "commit:validate": "tsx scripts/commit-validate.ts",
    "push:validate": "tsx scripts/push-validate.ts",
    "prepare": "git config core.hooksPath .husky || true",
    "api:once": "tsx apps/api/src/main.ts",
    "check:output": "tsx scripts/check-output.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  }
}
